// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SkinType {
  OILY // OLEOSO
  DRY // SECO
  COMBINATION // MISTO
  SENSITIVE // SENSIVEL
}

enum HairType {
  STRAIGHT // LISO
  WAVY // ONDULADO
  CURLY // CACHEADO
  COILY //  CRESPO
}

enum BudgetRange {
  LOW // BAIXO
  MEDIUM // MÉDIO
  HIGH // ALTO
}

enum AgeRange {
  TEEN
  YOUNG_ADULT
  ADULT
  MATURE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SkinConcern {
  ACNE
  MANCHAS
  LINHAS_FINAS
  POROS
  VERMELHIDAO
  OLHEIRAS
  RESSECAMENTO
}

enum HairConcern {
  FRIZZ
  QUEDA
  CASPA
  OLEOSIDADE
  PONTAS_DUPLAS
  VOLUME
  QUIMICA
}

enum IngredientToAvoid {
  PARABENOS
  SULFATOS
  SILICONES
  ALCOOL
  FRAGRANCIA
  OLEO_MINERAL
}

enum SunExposure {
  BAIXA
  MEDIA
  ALTA
}

enum ScentPreference {
  FLORAL
  AMADEIRADO
  CITRICO
  DOCE
  FRESCO
  SEM_PREFERENCIA
}

enum SkinTone {
  CLARO
  MEDIO
  MORENO
  ESCURO
}

enum MakeupCoverage {
  LEVE
  MEDIA
  ALTA
}

enum UserPlan {
  FREE
  PREMIUM
}

enum ProductCategory {
  SKINCARE_FACIAL
  CORPO
  CABELO
  MAQUIAGEM
  PROTECAO_SOLAR
  PERFUMARIA
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  plan      UserPlan @default(FREE)

  profile UserProfile?

  searchHistory SearchHistory[]

  usage Usage?
}

model UserProfile {
  id String @id @default(uuid())

  skinType SkinType?
  hairType HairType?
  budget   BudgetRange?
  ageRange AgeRange?
  gender   Gender?

  sensitiveSkin Boolean @default(false)
  veganOnly     Boolean @default(false)

  // Campos premium (todos opcionais). As 3 listas são arrays de enum no Postgres;
  // os 4 restantes são enum simples opcional. Gating FREE x PREMIUM é feito no front.
  skinConcerns       SkinConcern[]
  hairConcerns       HairConcern[]
  ingredientsToAvoid IngredientToAvoid[]

  sunExposure     SunExposure?
  scentPreference ScentPreference?
  skinTone        SkinTone?
  makeupCoverage  MakeupCoverage?

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SearchHistory {
  id String @id @default(uuid())

  query String

  userId String

  intent String?
  reply String?

  canonicalTerm String?          @db.VarChar(120)
  category      ProductCategory?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([canonicalTerm, createdAt])
}

model Usage {
  id String @id @default(uuid())

  questionsUsed Int @default(0)

  resetAt DateTime

  // Quando preenchido e no futuro, o usuário está temporariamente bloqueado do
  // chat por abuso (muitas requisições em pouco tempo). null = sem bloqueio.
  blockedUntil DateTime?

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TrendSource {
  AUTOCOMPLETE
}

model TrendSnapshot {
  id String @id @default(uuid())

  term     String          @db.VarChar(120)
  category ProductCategory
  source   TrendSource
  position Int

  capturedAt DateTime @default(now())

  @@index([term, capturedAt])
  @@index([category, capturedAt])
}

enum TrendDirection {
  RISING
  STABLE
  FALLING
}

model TrendScore {
  id String @id @default(uuid())

  term      String          @db.VarChar(120)
  category  ProductCategory
  score     Float
  delta     Float          @default(1)
  direction TrendDirection

  internalWeight Float
  externalWeight Float

  computedAt DateTime @default(now())

  @@index([computedAt, category])
  @@index([term, computedAt])
}
